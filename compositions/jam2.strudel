// "jam" @by Andrew

$: stack(
    n(irand(8).ribbon(43,4)).struct("[x x] x [x x] x")
      .scale("<balinese hungarian:minor>")
      .sound("gm_koto").gain("1.2")
      .color("hot pink"),
    sound("<bd [sd rim] oh>!! hh*2").gain(".5 .7 .9 1.1 1.3 1.5").jux(rev)
      .bank("rolandd70").gain(.8)
      .duck("2:3").duckdepth(irand("4"))
      .color("dark red"),
    n("- <2 3> - [3 4]")
      .sound("<gm_electric_bass_finger gm_electric_bass_pick>")
      .gain(3)
      .color("light blue"),
    note("g e <c c4 c6> g#")
      .sound("piano")
      .slow(2)
      .delay("2").sus("1.5")
      .color("yellow")
  ).pianoroll( {labels: 1, vertical: 1} )
