// "progressions" @by Andrew

// 12 bar blues
_$: n("0,3,7 !!!".add(`<0 0 0 0
                       3 3 0 0 
                       4 3 0 4>`))
    .scale("G#:minor")
    .sound("piano")
    .fast(2)

// circle progression
_$: n("0,4,7 @2".add(`<0 3 6 2 5 1 4>`))
    .scale("G:major")
    .sound("gm_rock_organ")
    .fast(2)

// do wop
_$: n("0,4,7 !!!".add(`<0 5 3 4 0>`))
    .scale("E:major")
    .sound("gm_electric_guitar_jazz")
    .fast(2)
